# ==========================================
# RustPlus Manager - Environment Variables (Template)
# ==========================================

# Server Port
PORT=3000
NODE_ENV=production

# Facepunch Rust Companion FCM / GCM Credentials
FCM_API_KEY=AIzaSy...
FCM_PROJECT_ID=rust-companion-app
FCM_GCM_SENDER_ID=REMOVED_GCM_SENDER_ID
FCM_GMS_APP_ID=REMOVED_GMS_APP_ID
FCM_PACKAGE_NAME=com.facepunch.rust.companion
FCM_PACKAGE_CERT=REMOVED_PACKAGE_CERT
EXPO_PROJECT_ID=REMOVED_EXPO_PROJECT_ID

# External APIs (Optional)
STEAM_API_KEY=
BATTLEMETRICS_TOKEN=

# Matrix Credentials (Optional, can also be configured via WebUI)
MATRIX_HOMESERVER=https://voice.trylocalhost.com
MATRIX_USERNAME=
MATRIX_PASSWORD=
MATRIX_USER_ID=
MATRIX_DEVICE_ID=RUSTPLUS_SENTINEL_E2EE
MATRIX_VOICE_ROOM_ID=
MATRIX_ALERTS_ROOM_ID=
MATRIX_TEAMCHAT_ROOM_ID=
MATRIX_RAID_ROOM_ID=
