# ==========================================
# RustPlus Manager - Environment Variables (Template)
# ==========================================

# Server Port
PORT=3000
NODE_ENV=production

# Facepunch Rust Companion FCM / GCM Credentials
FCM_API_KEY=your_fcm_api_key_here
FCM_PROJECT_ID=rust-companion-app
FCM_GCM_SENDER_ID=your_gcm_sender_id_here
FCM_GMS_APP_ID=your_gms_app_id_here
FCM_PACKAGE_NAME=com.facepunch.rust.companion
FCM_PACKAGE_CERT=your_android_package_cert_sha1_here
EXPO_PROJECT_ID=your_expo_project_id_here

# External APIs (Optional)
STEAM_API_KEY=
BATTLEMETRICS_TOKEN=

# Telegram Notification Relay (notificationsrelay.trylocalhost.com)
RELAY_URL=https://notificationsrelay.trylocalhost.com/api/send
RELAY_API_KEY=your_relay_api_key_here

# Matrix Credentials (Deprecated - disabled by default, WebUI used instead)
MATRIX_HOMESERVER=https://voice.trylocalhost.com
MATRIX_USERNAME=
MATRIX_PASSWORD=
MATRIX_USER_ID=
MATRIX_DEVICE_ID=RUSTPLUS_SENTINEL_E2EE
MATRIX_VOICE_ROOM_ID=
MATRIX_ALERTS_ROOM_ID=
MATRIX_TEAMCHAT_ROOM_ID=
MATRIX_RAID_ROOM_ID=
