[Unit]
Description=Telegram Notification Relay Service (notificationsrelay.trylocalhost.com)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/notification-relay
ExecStart=/usr/bin/node /opt/notification-relay/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001

[Install]
WantedBy=multi-user.target
